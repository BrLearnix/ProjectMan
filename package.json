{
  "name": "projectman",
  "displayName": "ProjectMan",
  "description": "A project manager for VS Code that automatically remembers your projects and lets you open them with one click.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:projectman.projects",
    "onCommand:projectman.addProject",
    "onCommand:projectman.openProject",
    "onCommand:projectman.removeProject",
    "onCommand:projectman.refresh",
    "onCommand:projectman.show",
    "onCommand:projectman.togglePath"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "projectman",
          "title": "ProjectMan",
          "icon": "media/projectman-icon.svg"
        }
      ]
    },
    "views": {
      "projectman": [
        {
          "id": "projectman.projects",
          "name": "Proyectos"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "projectman.projects",
        "contents": "No hay proyectos todavía.\n[Añadir proyecto](command:projectman.addProject)"
      }
    ],
    "commands": [
      {
        "command": "projectman.addProject",
        "title": "ProjectMan: Añadir proyecto",
        "icon": "$(add)"
      },
      {
        "command": "projectman.show",
        "title": "ProjectMan: Mostrar proyectos"
      },
      {
        "command": "projectman.openProject",
        "title": "ProjectMan: Abrir proyecto",
        "icon": "$(go-to-file)"
      },
      {
        "command": "projectman.removeProject",
        "title": "ProjectMan: Eliminar proyecto",
        "icon": "$(trash)"
      },
      {
        "command": "projectman.refresh",
        "title": "ProjectMan: Actualizar",
        "icon": "$(refresh)"
      },
      {
        "command": "projectman.togglePath",
        "title": "ProjectMan: Ver/ocultar ruta"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "projectman.addProject",
          "when": "view == projectman.projects",
          "group": "navigation@1"
        },
        {
          "command": "projectman.refresh",
          "when": "view == projectman.projects",
          "group": "navigation@2"
        },
        {
          "command": "projectman.togglePath",
          "when": "view == projectman.projects",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "projectman.openProject",
          "when": "view == projectman.projects && viewItem == project",
          "group": "inline@1"
        },
        {
          "command": "projectman.removeProject",
          "when": "view == projectman.projects && viewItem == project",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "esbuild": "^0.28.1",
    "npm-run-all": "^4.1.5",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
